rules_version = '2';
/**
 * Firestore 행 수준 보안(RLS에 해당).
 * - 비로그인: 모든 문서 읽기·쓰기 거부
 * - 로그인: 본인 uid 문서만 읽기·쓰기 (공유 패키지는 로그인 사용자만 링크 열람)
 * - profile.plan / paid* : Admin SDK(Callable)만 변경
 */
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** profile.plan / paid* — Admin SDK(Callable)만 변경 가능 */
    function profilePlanIsFreeOrAbsent() {
      let p = request.resource.data.get('profile', {});
      return p.get('plan', 'free') == 'free'
        && !p.keys().hasAny(['paidUpdatedAt', 'paidUpdatedBy', 'paidEmail']);
    }

    function profileProtectedFieldsUnchanged() {
      let before = resource.data.get('profile', {});
      let after = request.resource.data.get('profile', {});
      return after.get('plan', 'free') == before.get('plan', 'free')
        && after.get('paidUpdatedAt', 0) == before.get('paidUpdatedAt', 0)
        && after.get('paidUpdatedBy', '') == before.get('paidUpdatedBy', '')
        && after.get('paidEmail', '') == before.get('paidEmail', '');
    }

    match /betaDailyUsage/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'feedbackBonusDayId',
          'signupBonusGranted',
          'signupBonusSpellingRemaining',
          'signupBonusConsistencyRemaining',
          'signupBonusPolicyVersion'
        ])
        && (
          !('feedbackBonusDayId' in request.resource.data)
          || (request.resource.data.feedbackBonusDayId is string
            && request.resource.data.feedbackBonusDayId.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        )
        && (
          !('signupBonusGranted' in request.resource.data)
          || request.resource.data.signupBonusGranted == true
        )
        && (
          !('signupBonusSpellingRemaining' in request.resource.data)
          || (request.resource.data.signupBonusSpellingRemaining is int
            && request.resource.data.signupBonusSpellingRemaining >= 0
            && request.resource.data.signupBonusSpellingRemaining <= 5)
        )
        && (
          !('signupBonusConsistencyRemaining' in request.resource.data)
          || (request.resource.data.signupBonusConsistencyRemaining is int
            && request.resource.data.signupBonusConsistencyRemaining >= 0
            && request.resource.data.signupBonusConsistencyRemaining <= 5)
        )
        && (
          !('signupBonusPolicyVersion' in request.resource.data)
          || (request.resource.data.signupBonusPolicyVersion is int
            && request.resource.data.signupBonusPolicyVersion >= 1
            && request.resource.data.signupBonusPolicyVersion <= 2)
        );
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'feedbackBonusDayId',
              'signupBonusGranted',
              'signupBonusSpellingRemaining',
              'signupBonusConsistencyRemaining',
              'signupBonusPolicyVersion'
            ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['feedbackBonusDayId'])
          || (request.resource.data.feedbackBonusDayId is string
            && request.resource.data.feedbackBonusDayId.matches('^\\d{4}-\\d{2}-\\d{2}$'))
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signupBonusGranted'])
          || request.resource.data.signupBonusGranted == true
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signupBonusPolicyVersion'])
          || (request.resource.data.signupBonusPolicyVersion is int
            && request.resource.data.signupBonusPolicyVersion >= 1
            && request.resource.data.signupBonusPolicyVersion <= 2
            && request.resource.data.signupBonusPolicyVersion
              >= resource.data.get('signupBonusPolicyVersion', 0))
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signupBonusSpellingRemaining'])
          || (request.resource.data.signupBonusSpellingRemaining is int
            && request.resource.data.signupBonusSpellingRemaining >= 0
            && request.resource.data.signupBonusSpellingRemaining <= 5
            && (
              // 검수 소비 — 잔여만 감소
              request.resource.data.signupBonusSpellingRemaining
                <= resource.data.get('signupBonusSpellingRemaining', 5)
              // 정책 재정렬 — 버전과 함께 각 5회로 맞춤
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['signupBonusPolicyVersion'])
                && request.resource.data.signupBonusSpellingRemaining == 5
              )
            ))
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['signupBonusConsistencyRemaining'])
          || (request.resource.data.signupBonusConsistencyRemaining is int
            && request.resource.data.signupBonusConsistencyRemaining >= 0
            && request.resource.data.signupBonusConsistencyRemaining <= 5
            && (
              request.resource.data.signupBonusConsistencyRemaining
                <= resource.data.get('signupBonusConsistencyRemaining', 5)
              || (
                request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['signupBonusPolicyVersion'])
                && request.resource.data.signupBonusConsistencyRemaining == 5
              )
            ))
        );
      allow delete: if false;
    }

    match /betaDailyUsage/{userId}/days/{dayId} {
      allow read: if isOwner(userId);
      // 일일 최대 2 + 가입 보너스 5 = 7 (여유 상한 12)
      allow create: if isOwner(userId)
        && request.resource.data.usedAt is timestamp
        && request.resource.data.get('spellingCount', 0) is int
        && request.resource.data.get('consistencyCount', 0) is int
        && request.resource.data.get('spellingCount', 0) >= 0
        && request.resource.data.get('consistencyCount', 0) >= 0
        && request.resource.data.get('spellingCount', 0) <= 12
        && request.resource.data.get('consistencyCount', 0) <= 12
        && (
          request.resource.data.get('spellingCount', 0)
            + request.resource.data.get('consistencyCount', 0)
            >= 1
        );
      allow update: if isOwner(userId)
        && request.resource.data.usedAt is timestamp
        && (
          (request.resource.data.spellingCount == resource.data.get('spellingCount', 0) + 1
            && request.resource.data.spellingCount <= 12
            && request.resource.data.consistencyCount == resource.data.get('consistencyCount', 0))
          || (request.resource.data.consistencyCount == resource.data.get('consistencyCount', 0) + 1
            && request.resource.data.consistencyCount <= 12
            && request.resource.data.spellingCount == resource.data.get('spellingCount', 0))
          || (
            request.resource.data.spellingCount == resource.data.get('spellingCount', 0)
            && request.resource.data.consistencyCount == resource.data.get('consistencyCount', 0)
          )
        );
      allow delete: if false;
    }

    match /userCriteria/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && profilePlanIsFreeOrAbsent();
      allow update: if isOwner(userId) && profileProtectedFieldsUnchanged();
      allow delete: if false;

      match /checkResults/{resultId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.uid == userId
          && request.resource.data.kind in ['spelling', 'consistency']
          && request.resource.data.projectId is string
          && request.resource.data.projectId.size() > 0
          && request.resource.data.createdAt is number
          && request.resource.data.expiresAt is number
          && request.resource.data.schemaVersion is number;
        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    /**
     * 공유 패키지 — PDF 없음. 문서 id = 링크 토큰.
     * 읽기: 로그인 사용자만 (비로그인 거부). 쓰기는 본인 생성분만.
     */
    match /sharePackages/{packageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.schemaVersion is number
        && request.resource.data.createdAt is number
        && request.resource.data.expiresAt is number
        && request.resource.data.sourceProjectId is string
        && request.resource.data.sourceName is string
        && request.resource.data.keys().hasAll([
          'schemaVersion', 'createdAt', 'expiresAt', 'createdByUid',
          'sourceProjectId', 'sourceName', 'meta', 'criteria', 'checkResults'
        ])
        && !request.resource.data.keys().hasAny(['pdf', 'pdfBytes', 'fileBytes', 'pdfData']);
      allow update: if false;
      allow delete: if isSignedIn()
        && resource.data.createdByUid == request.auth.uid;
    }

    /** 위에 명시되지 않은 경로 — 전부 거부 */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
